# Copy to .env and adjust as needed. This app reads these via os.getenv, so
# you'll need to export them into your shell/container -- a .env file alone
# is not auto-loaded (no python-dotenv dependency is installed).

# Comma-separated list of browser origins allowed to call this API directly.
# Same-origin requests to the bundled frontend (served at "/") never need
# this. Only set it if you're calling the API from another origin, e.g. a
# separately hosted frontend or the Streamlit dashboard on another host.
# Defaults to common localhost dev origins if unset.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Retrieval mode: auto | lexical | embedding | faiss
# "auto" tries faiss, then embeddings, then falls back to lexical.
# Embedding/faiss modes require ENABLE_SENTENCE_TRANSFORMERS=1 below and
# `pip install -r requirements-ml.txt`.
RETRIEVAL_MODE=auto

# Set to 1 to enable sentence-transformers-based embedding retrieval.
# Requires requirements-ml.txt to be installed; otherwise silently falls
# back to lexical retrieval.
ENABLE_SENTENCE_TRANSFORMERS=0
