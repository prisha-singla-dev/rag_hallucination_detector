# --- Answer generation (backend/core/generator.py) ---
# Leave GEMINI_API_KEY unset to run in "template" mode: answers are built by
# concatenating retrieved evidence, clearly labeled generation_mode="template"
# in every API response. Set it to call the real Gemini API instead
# (generation_mode="llm"). Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2

# --- Claim grounding (backend/core/grounding.py) ---
# lexical | nli | auto (default). "auto" prefers the NLI cross-encoder and
# falls back to the lexical scorer if sentence-transformers / model weights
# aren't available. NLI requires `pip install -r requirements-ml.txt`, and
# the first run downloads cross-encoder/nli-deberta-v3-base (~440MB).
GROUNDING_MODE=auto
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-base