# --- Answer generation (backend/core/generator.py) ---
# Leave GEMINI_API_KEY unset to run in "template" mode: answers are built by
# concatenating retrieved evidence, clearly labeled generation_mode="template"
# in every API response. Set it to call the real Gemini API instead
# (generation_mode="llm"). Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2

# --- Claim grounding (backend/core/grounding.py) ---
# lexical (default) | nli | auto. Local dev only: for a live NLI demo,
# install requirements-ml.txt then set GROUNDING_MODE=nli (fails loudly if
# the model isn't available) or =auto (falls back to lexical, logged as an
# ERROR). The deployed Docker image (render.yaml) pins GROUNDING_MODE=lexical
# explicitly -- the free-tier host does not have enough RAM to reliably load
# the NLI cross-encoder (~700MB-1.5GB with torch), so NLI is proven via
# eval/results/README.md and local runs, not the live public demo.
GROUNDING_MODE=lexical
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-base